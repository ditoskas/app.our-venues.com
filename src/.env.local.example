MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=o-gamos-mas

# Signs session cookies — generate one with: openssl rand -base64 32
SESSION_SECRET=

# S3 bucket for every uploaded file (logos, celebration images), keyed under
# professionals/<professionalId>/... — see "File uploads" in CLAUDE.md.
# S3_BUCKET and S3_REGION are required.
S3_BUCKET=
S3_REGION=eu-central-1
# Optional explicit keys. Leave empty to use the AWS SDK's default credential
# chain (IAM role, AWS_* env vars, ~/.aws profile).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for an S3-compatible server instead of AWS — e.g. the S3Mock container
# from docker-compose, reachable from the host at http://localhost:9090
# (bucket "o-gamos-mas", any keys, S3_FORCE_PATH_STYLE=true).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Google Maps JavaScript API key, used by the Events tab's map point picker
# (celebrations/[id]/GoogleMapPicker.tsx) to render the map and geocode
# addresses. Needs the Maps JavaScript API and Geocoding API enabled on a
# billing-enabled Google Cloud project. NEXT_PUBLIC_ so it's readable from
# the browser — restrict it to your domain(s) in the Google Cloud Console
# rather than leaving it unrestricted. Without it, the map picker shows a
# "not configured" message but the rest of the Events tab still works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Root user's password — only used when the seeder first creates the Root
# user (an existing user is never changed). Leave empty in dev to get a
# random one printed once in the server log's seed table; required in
# production (the Root user isn't created without it).
SEED_ROOT_PASSWORD=
