MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=o-gamos-mas

# Signs session cookies — generate one with: openssl rand -base64 32
SESSION_SECRET=

# Signs the bearer token issued to a guest after they verify their public
# 2FA code (see PUBLIC-API.md, GET /api/public/access/confirm) — separate
# from SESSION_SECRET so a leaked guest token can't be replayed against
# admin auth. Generate one with: openssl rand -base64 32
GUEST_SESSION_SECRET=

# Root folder for uploaded files (professional logos live under
# <UPLOADS_DIR>/professionals/<id>/images/). In Docker this is a mounted
# volume at /shared; for local dev point it at any writable folder.
UPLOADS_DIR=

# Google Maps JavaScript API key, used by the Events tab's map point picker
# (celebrations/[id]/GoogleMapPicker.tsx) to render the map and geocode
# addresses. Needs the Maps JavaScript API and Geocoding API enabled on a
# billing-enabled Google Cloud project. NEXT_PUBLIC_ so it's readable from
# the browser — restrict it to your domain(s) in the Google Cloud Console
# rather than leaving it unrestricted. Without it, the map picker shows a
# "not configured" message but the rest of the Events tab still works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Brevo (formerly Sendinblue) API key, used by lib/brevo.ts to send
# transactional email (currently just the guest 2FA code email, see
# lib/twoFactorEmail.ts and PUBLIC-API.md's GET /api/public/access/confirm)
# via https://api.brevo.com/v3/smtp/email. Get one from Brevo's dashboard
# under SMTP & API > API Keys. Without it, sending a 2FA code to an email
# contact fails (a phone contact is unaffected — it has no email delivery
# to begin with).
BREVO_API_KEY=
