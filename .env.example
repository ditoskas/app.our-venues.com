# Read by docker-compose.yml for variable substitution (${VAR} syntax) —
# copy to .env (gitignored) in this same directory and fill in real values.
# This is separate from src/.env.local(.example), which is only read by
# `next dev` running directly on the host (not via Docker).

# Google Maps JavaScript API key — see src/.env.local.example for details
# on what it's used for and which Google Cloud APIs it needs enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Uploaded-file storage. Leave all of these unset to use the local S3Mock
# container from docker-compose. To use a real AWS S3 bucket instead, set
# S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY, and set
# S3_ENDPOINT to an empty value and S3_FORCE_PATH_STYLE=false.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Root user's password — only used when the seeder first creates the Root
# user (an existing user is never changed). Leave empty to get a random one
# printed once in the backend log's seed table.
SEED_ROOT_PASSWORD=
