# Read by docker-compose.yml for variable substitution (${VAR} syntax) —
# copy to .env (gitignored) in this same directory and fill in real values.
# This is separate from src/.env.local(.example), which is only read by
# `next dev` running directly on the host (not via Docker).

# Google Maps JavaScript API key — see src/.env.local.example for details
# on what it's used for and which Google Cloud APIs it needs enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Brevo transactional email API key — see src/.env.local.example for
# details on what it's used for.
BREVO_API_KEY=
